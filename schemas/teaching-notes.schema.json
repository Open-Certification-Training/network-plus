{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Topic teaching notes",
  "type": "object",
  "required": ["@context", "@type", "@id", "name", "isPartOf", "hasPart"],
  "properties": {
    "@context": { "const": "https://schema.org" },
    "@type": { "const": "LearningResource" },
    "@id": { "$ref": "#/$defs/text" },
    "name": { "$ref": "#/$defs/text" },
    "isPartOf": { "$ref": "#/$defs/reference" },
    "hasPart": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["@type", "name", "about", "text", "citation"],
        "properties": {
          "@type": { "const": "LearningResource" },
          "name": { "$ref": "#/$defs/text" },
          "about": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/reference" }
          },
          "text": { "$ref": "#/$defs/text" },
          "citation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["@type", "name", "url"],
              "properties": {
                "@type": { "$ref": "#/$defs/text" },
                "name": { "$ref": "#/$defs/text" },
                "url": { "$ref": "#/$defs/text" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "reference": {
      "type": "object",
      "required": ["@id"],
      "properties": { "@id": { "$ref": "#/$defs/text" } }
    }
  }
}
